{
  "type": "record",
  "name": "hotel_reviews",
  "namespace": "com.example",
  "fields": [
    {
      "name": "id",
      "type": {
        "type": "string",
        "arg.properties": {
          "regex": "[A][VW][A-Za-z0-9]{18}"
        }
      }
    },
    {
      "name": "address",
      "type": {
        "type": "string",
        "arg.properties": {
          "regex": "[1-9][0-9]{1,4} [A-Z][a-z]+ (St|Ave|Blvd|Rd|Dr)"
        }
      }
    },
    {
      "name": "categories",
      "type": {
        "type": "string",
        "arg.properties": {
          "options": [
            "Hotels|Resorts|Lodging", 
            "Bed & Breakfast|Inns|Suites", 
            "Extended Stay|Banquet facilities|Corporate Lodging",
            "Business Hotels|Conference Room|Golf Courses",
            "Tourist Hotels|Family-friendly Hotels", 
            "Weekend Gateway Hotels|Motels"
          ]
        }
      }
    },
    {
      "name": "primary_categories",
      "type": {
        "type": "string",
        "arg.properties": {
          "options": ["Accommodation & Food Services", "Travel & Tourism"]
        }
      }
    },
    {
      "name": "city",
      "type": {
        "type": "string",
        "arg.properties": {
          "options": ["San Francisco", "New York", "Chicago", "Miami", "Las Vegas", 
            "Woodstock", "Wichita", "Virginia Beach", "Vancouver", "Utah",
            "Union Dale", "Tucson", "Tarpon Springs", "Sunnyvale", "Springfield",
            "South Lake Tahoe", "Simpsonville", "San Diego", "San Jose",
            "Richmond", "Princeton", "Portland", "Pittsburgh", "Philadelphia",
            "Orlando", "Oxford", "Oklahoma City", "Norfolk", "Newport", "New Orleans",
            "Nashville", "Minneapolis", "Los Angeles", "Kansas City", "Ithaca",
            "Jacksonville", "Indiana", "Houston", "Greenville", "Freeport", "Fremont",
            "Denver", "Columbia", "Cleveland", "Bradford", "Boise", "Baltimore", 
            "Arlington", "Arkansas City", "Albuquerque"]
        }
      }
    },
    {
      "name": "country",
      "type": {
        "type": "string",
        "arg.properties": {
          "options": ["US"]
        }
      }
    },
    {
      "name": "latitude",
      "type": {
        "type": "double",
        "arg.properties": {
          "range": { "min": 25.0, "max": 48.0 }
        }
      }
    },
    {
      "name": "longitude",
      "type": {
        "type": "double",
        "arg.properties": {
          "range": { "min": -122.0, "max": -73.0 }
        }
      }
    },
    {
      "name": "name",
      "type": {
        "type": "string",
        "arg.properties": {
          "options": ["Grand Plaza Hotel", 
            "Seaside Resort", 
            "Central Park Suites", 
            "Sunrise Inn", 
            "Metropolitan Lodge",
            "Admiral Hotel",
            "Best Western",
            "Chelsea Savoy Hotel",
            "Daytona Shores Inn And Suites",
            "Empress Hotel",
            "Fairfield Inn & Suites Naples",
            "Hampton Inn Brentwood",
            "King Charles Inn",
            "La Quinta Inn Norfolk Virginia Beach",
            "Magnuson Hotel Nashville North",
            "NYLO Plano at Legacy",
            "Omni Royal Orleans",
            "Pier 5 Hotel Baltimore",
            "Quality Inn",
            "Ramada Flagstaff East",
            "Sheraton Kansas City Hotel at Crown Center",
            "The Boxer",
            "The Chateau Motel",
            "The Restoration",
            "The St. Regis New York",
            "The Westin Las Vegas Hotel & Spa",
            "W Boston",
            "Wild River Inn",
            "Wyndham Garden San Jose Silicon Valley"
          ]
        }
      }
    },
    {
      "name": "postal_code",
      "type": {
        "type": "string",
        "arg.properties": {
          "regex": "[1-9][0-9]{4}"
        }
      }
    },
    {
      "name": "province",
      "type": {
        "type": "string",
        "arg.properties": {
          "options": ["CA", "NY", "IL", "FL", 
            "NV", "AK", "DE", "GA", "HI", "IL",
            "LA", "MD", "MO", "NJ", "NV", "OR",
            "PA", "SC", "TX", "VA"
          ]
        }
      }
    },
    {
      "name": "reviews_date",
      "type": {
        "type": "string",
        "arg.properties": {
          "regex": "20(0[2-9]|1[0-8])-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z"
        }
      }
    },
    {
      "name": "reviews_rating",
      "type": {
        "type": "int",
        "arg.properties": {
          "range": { "min": 1, "max": 5 }
        }
      }
    },
    {
      "name": "reviews_text",
      "type": {
        "type": "string",
        "arg.properties": {
          "options": [
            "Great stay! Room was clean and staff was very polite.",
            "Average experience. The air conditioning was noisy.",
            "Wonderful location close to downtown attractions.",
            "Disappointing service at check-in, but rooms were nice.",
            "Highly recommended! Will definitely visit again."
          ]
        }
      }
    },
    {
      "name": "reviews_title",
      "type": {
        "type": "string",
        "arg.properties": {
          "options": ["Awesome experience!", "Could be better", "Great location", "Decent stay", "Loved it!"]
        }
      }
    },
    {
      "name": "reviews_user_city",
      "type": {
        "type": "string",
        "arg.properties": {
          "options": ["Seattle", "Austin", "Boston", "Denver", "Atlanta", "Alaska",
            "Minneapolis", "New Zealand", "Houston", "Phoenix", "Tucson", "San Diego"
          ]
        }
      }
    },
    {
      "name": "reviews_username",
      "type": {
        "type": "string",
        "arg.properties": {
          "regex": "(Anonymous|[A-Za-z]{4,8} [A-Za-z0-9]+)"
        }
      }
    }
  ]
}